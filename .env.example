# Documentation only. Wrangler secrets belong in .dev.vars (ignored).
APP_ORIGIN=https://world.euiyun.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DEV_AUTH_ENABLED=false
MARKET_ENABLED=true
WORLD_AUTO_SPLIT_ENABLED=false
COMBAT_ENABLED=false
PAYMENTS_ENABLED=false
LAND_TRADING_ENABLED=false

# Optional Vite build-time vector TileJSON source; update attribution/CSP for another provider.
VITE_MAP_SOURCE_URL=https://tiles.openfreemap.org/planet
